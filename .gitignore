# API 키 등 민감 설정
config/.env
.env

# 런타임 데이터 (정류소/설정은 설정 페이지에서 자동 저장, 캐시·로그는 재생성됨)
data/app_settings.json
data/bus_stops.json
data/commute_stops.json
data/bus_cache.json
data/weather_cache.json
data/holiday_cache.json
data/thumbnails/
