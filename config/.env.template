# ─── 필수 API 키 (공공데이터포털 https://www.data.go.kr/) ───────────────────
WEATHER_API_KEY=여기에_기상청_API_키_입력
HOLIDAY_API_KEY=여기에_공휴일_API_키_입력
BUS_API_KEY=여기에_버스_API_키_입력

# ─── Flask 서버 설정 ─────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=여기에_랜덤_비밀키_입력

# ─── 개발/테스트 모드 ─────────────────────────────────────────────────────────
# TEST_MODE=true 시 실제 API 대신 더미 데이터 사용
TEST_MODE=false

# ─── 날씨 격자 좌표 (기상청 격자 좌표계) ────────────────────────────────────
# 서울 노원: NX=61, NY=127
WEATHER_NX=61
WEATHER_NY=127

# ─── 캐시 유효시간 (초 단위) ───────────────────────────────────────────────
BUS_CACHE_TTL=60
WEATHER_CACHE_TTL=1800
HOLIDAY_CACHE_TTL=86400

# ─── 모니터 제어 (라즈베리파이 Wayland) ─────────────────────────────────────
MONITOR_OUTPUT=HDMI-A-1
MONITOR_CONTROL=true

# ─── Pi Vitals 상태 화면 (선택, ST7789 SPI 172x320) ─────────────────────────
# pi-vitals.service로 실행되는 별도 데몬. 화면/배선이 없어도 그냥 두면
# data/pi_vitals_preview.png로 드라이런된다.
PI_VITALS_ORIENTATION=portrait
# landscape일 때만 의미 있음 — 리본 케이블이 나가는 쪽(모듈을 눕히는 방향)
PI_VITALS_DIRECTION=left
PI_VITALS_STYLE=round
PI_VITALS_REFRESH_SEC=1.0
PI_VITALS_SPI_PORT=0
PI_VITALS_SPI_DEVICE=0
PI_VITALS_GPIO_DC=25
PI_VITALS_GPIO_RST=27
PI_VITALS_GPIO_BL=18
# lsblk로 확인한 SSD 디바이스명 (USB로 부팅한 경우 보통 sda)
PI_VITALS_DISK_DEVICE=sda
