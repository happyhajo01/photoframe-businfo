# 포토프레임 키오스크용 sway 최소 설정.
# kiosk-start.sh가 `sway --config`로 이 파일을 지정해 실행한다.

exec $HOME/photoframe-businfo/scripts/kiosk-browser.sh

default_border none
default_floating_border none
for_window [app_id=".*"] fullscreen enable

# 3초(3000ms) 동안 입력이 없으면 커서를 숨긴다. 움직이면 바로 다시 보인다.
seat seat0 hide_cursor 3000
